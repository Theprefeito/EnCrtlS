  - textDialogue: Seloko
    npcName: Coringa
    npcIcon: {fileID: -3315247072422729063, guid: 438786b00517f1d48afea18b615f22a0, type: 3}
  - textDialogue: "Hora bolas, n\xE3o haja assim, tenha d\xF3"
