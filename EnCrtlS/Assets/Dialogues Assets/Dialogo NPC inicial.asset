  lines:
  - textDialogue: Ola, seja bem vindo a Planeta Marte meu caro amigo, pequeno e baixo,
      super pequeno, vermelho e pequeno panda
    npcName: O rei
    npcIcon: {fileID: 1746982975475920463, guid: 5ab0986d9407f714286eca1c5cd9bd29, type: 3}
  - textDialogue: Ola, obrigado
    npcName: O joukir
    npcIcon: {fileID: -3315247072422729063, guid: 438786b00517f1d48afea18b615f22a0, type: 3}
  - textDialogue: De nada, agora morra!
    npcName: O rei
    npcIcon: {fileID: 1746982975475920463, guid: 5ab0986d9407f714286eca1c5cd9bd29, type: 3}
  - textDialogue: ..........
